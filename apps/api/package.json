{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" ",
    "lint": "pnpm run lint:check",
    "typecheck": "tsc --noEmit",
    "test": "jest --config ./test/jest.e2e.ts --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest.e2e.ts --runInBand",
    "test:load": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest.load.ts --runInBand",
    "load:contention": "node load/run.mjs contention",
    "load:spike": "node load/run.mjs spike",
    "test:db:reset": "DATABASE_NAME=seat-sure-test pnpm catalog:db:drop && DATABASE_NAME=seat-sure-test pnpm ticketing:db:drop && DATABASE_NAME=seat-sure-test pnpm user-profile:db:drop && DATABASE_NAME=seat-sure-test pnpm identity:db:drop && DATABASE_NAME=seat-sure-test pnpm billing:db:drop && DATABASE_NAME=seat-sure-test pnpm notifications:db:drop && DATABASE_NAME=seat-sure-test pnpm catalog:db:migrate && DATABASE_NAME=seat-sure-test pnpm ticketing:db:migrate && DATABASE_NAME=seat-sure-test pnpm user-profile:db:migrate && DATABASE_NAME=seat-sure-test pnpm identity:db:migrate && DATABASE_NAME=seat-sure-test pnpm billing:db:migrate && DATABASE_NAME=seat-sure-test pnpm notifications:db:migrate",
    "catalog:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/catalog/persistence/migration/migration  -d src/module/catalog/persistence/typeorm-datasource.ts",
    "catalog:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/catalog/persistence/typeorm-datasource.ts",
    "catalog:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/catalog/persistence/typeorm-datasource.ts",
    "ticketing:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/ticketing/persistence/migration/migration -d src/module/ticketing/persistence/typeorm-datasource.ts",
    "ticketing:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/ticketing/persistence/typeorm-datasource.ts",
    "ticketing:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/ticketing/persistence/typeorm-datasource.ts",
    "user-profile:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/user-profile/persistence/migration/migration -d src/module/user-profile/persistence/typeorm-datasource.ts",
    "user-profile:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/user-profile/persistence/typeorm-datasource.ts",
    "user-profile:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/user-profile/persistence/typeorm-datasource.ts",
    "identity:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/identity/persistence/migration/migration -d src/module/identity/persistence/typeorm-datasource.ts",
    "identity:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/identity/persistence/typeorm-datasource.ts",
    "identity:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/identity/persistence/typeorm-datasource.ts",
    "billing:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/billing/persistence/migration/migration -d src/module/billing/persistence/typeorm-datasource.ts",
    "billing:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/billing/persistence/typeorm-datasource.ts",
    "billing:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/billing/persistence/typeorm-datasource.ts",
    "notifications:db:generate": "tsx ./node_modules/typeorm/cli.js migration:generate src/module/notifications/persistence/migration/migration -d src/module/notifications/persistence/typeorm-datasource.ts",
    "notifications:db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/module/notifications/persistence/typeorm-datasource.ts",
    "notifications:db:drop": "tsx ./node_modules/typeorm/cli.js schema:drop -d src/module/notifications/persistence/typeorm-datasource.ts",
    "db:generate:all": "pnpm catalog:db:generate && pnpm ticketing:db:generate && pnpm user-profile:db:generate && pnpm identity:db:generate && pnpm billing:db:generate && pnpm notifications:db:generate",
    "db:migrate:all": "pnpm catalog:db:migrate && pnpm ticketing:db:migrate && pnpm user-profile:db:migrate && pnpm identity:db:migrate && pnpm billing:db:migrate && pnpm notifications:db:migrate",
    "db:drop:all": "pnpm catalog:db:drop && pnpm ticketing:db:drop && pnpm user-profile:db:drop && pnpm identity:db:drop && pnpm billing:db:drop && pnpm notifications:db:drop",
    "docker:build": "docker-compose --profile all build",
    "docker:start": "docker-compose --profile all up -d",
    "docker:start:deps": "docker-compose --profile deps up -d",
    "docker:down:deps": "docker-compose --profile deps down",
    "docker:down": "docker-compose --profile all down",
    "demo:seed": "node demo/seed.mjs",
    "demo:reset": "node demo/reset.mjs",
    "demo:migrate": "node demo/migrate.mjs",
    "demo:start": "node demo/start.mjs",
    "test:demo": "cd ../.. && node --test --test-concurrency=1 apps/api/demo/*.test.mjs"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@google/genai": "^0.13.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/typeorm": "^11.0.3",
    "@seat-sure/shared": "workspace:*",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "mongodb": "^7.5.0",
    "nest-winston": "^1.10.2",
    "nestjs-cls": "^5.4.3",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0",
    "typeorm-extension": "^3.9.0",
    "typeorm-transactional": "^0.5.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "dotenv": "^18.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-project-structure": "^3.14.4",
    "factory.ts": "^1.4.2",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "knex": "^3.3.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coveragePathIgnorePatterns": [
      "-migration\\.ts$"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
